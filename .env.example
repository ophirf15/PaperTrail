# Names only. Put real values in .env, which is gitignored.

# Random string used to encrypt an optional GitHub token at rest.
APP_KEY=

# sqlite or mysql. The installer writes this.
PAPER_TRAIL_DB_DRIVER=sqlite

# SQLite file. Leave blank to use data/paper-trail.sqlite.
PAPER_TRAIL_DB_PATH=

# MySQL, used when PAPER_TRAIL_DB_DRIVER=mysql.
PAPER_TRAIL_DB_HOST=localhost
PAPER_TRAIL_DB_PORT=3306
PAPER_TRAIL_DB_NAME=
PAPER_TRAIL_DB_USER=
PAPER_TRAIL_DB_PASSWORD=

# owner/repo used by Settings → Check for updates. Leave blank to disable.
PAPER_TRAIL_GITHUB_REPO=

# Optional token for a private release. Prefer the environment over the database.
GITHUB_TOKEN=

# Set to true before the in-app updater is allowed to overlay files.
PAPER_TRAIL_UPDATES_ENABLED=false
